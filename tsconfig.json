{
  // Type-checks the JavaScript with JSDoc and the Playwright types, nothing is compiled
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.mjs", "tests/**/*.mjs", "selftest/**/*.mjs"]
}
